<Window x:Class="VongQuayMayManNQC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Vòng Quay May Mắn NQC"
        Height="980"
        Width="1680"
        Icon="/Assets/logovq.ico"
        MinWidth="1450"
        MinHeight="900"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">

    <Window.Resources>
        <!-- ===== MÀU CHỦ ĐẠO ===== -->
        <SolidColorBrush x:Key="BgMainBrush" Color="#0B1220"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#111827"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#243046"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8"/>

        <!-- ===== TEXT ===== -->
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="26"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== PANEL ===== -->
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- ===== TEXTBOX ===== -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== BUTTON ===== -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>

        <!-- ===== COMBOBOX FIX CHỮ HIỂN THỊ ===== -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,6,36,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"/>

                            <Grid>
                                <!-- Presenter hiển thị item đang chọn -->
                                <ContentPresenter x:Name="ContentSite"
                                                  Margin="12,0,36,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  IsHitTestVisible="False"
                                                  RecognizesAccessKey="True"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

                                <!-- mũi tên xổ xuống -->
                                <Border Width="34"
                                        HorizontalAlignment="Right"
                                        Background="Transparent">
                                    <Path Width="12"
                                          Height="8"
                                          Stretch="Fill"
                                          Fill="#475569"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 6 6 L 12 0 Z"/>
                                </Border>

                                <ToggleButton x:Name="ToggleButton"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"/>
                            </Grid>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="White"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Margin="0,4,0,0">
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#111827"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        Margin="2">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBd" Property="Background" Value="#EFF6FF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBd" Property="Background" Value="#DBEAFE"/>
                                        <Setter Property="Foreground" Value="#111827"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- ===== LISTBOX ===== -->
        <Style x:Key="ModernListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <!-- ===== DATAGRID ĐEN CHỮ TRẮNG ===== -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2B2B2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#222"/>
            <Setter Property="VerticalGridLinesBrush" Value="#222"/>
            <Setter Property="AlternatingRowBackground" Value="#111111"/>
            <Setter Property="RowBackground" Value="#000000"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#222"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#1C1C1C"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A5F"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgMainBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Margin="18,16,18,10"
                CornerRadius="20"
                Background="#111827"
                BorderBrush="#243046"
                BorderThickness="1"
                Padding="20,16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="VÒNG QUAY MAY MẮN NQC"
                               Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="@Được phát triển bởi Cường CNTT"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Right"
                        Background="#0F172A"
                        BorderBrush="#2B3950"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,10"
                        Margin="18,0,0,0">
                    <StackPanel>
                        <TextBlock Text="GIẢI ĐANG QUAY"
                                   Foreground="#94A3B8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtCurrentPrizeBadge"
                                   Text="Chưa chọn giải"
                                   Foreground="#F59E0B"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18,0,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Người tham gia -->
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Danh sách người tham gia" Style="{StaticResource SectionTitleStyle}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtNameInput"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBoxStyle}"/>

                                <Button Grid.Column="2"
                                        Content="Thêm"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Background="#2563EB"
                                        Margin="0"
                                        Click="BtnAddParticipant_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Nhập từ Excel"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Background="#0EA5E9"
                                        Click="BtnImportExcel_Click"/>

                                <Button Grid.Column="2"
                                        Content="Xóa người chọn"
                                        Style="{StaticResource SmallButtonStyle}"
                                        Background="#EF4444"
                                        Margin="0"
                                        Click="BtnRemoveSelected_Click"/>
                            </Grid>

                            <ListBox x:Name="lstParticipants"
                                     Height="220"
                                     Style="{StaticResource ModernListBoxStyle}"
                                     DisplayMemberPath="Name"/>
                        </StackPanel>
                    </Border>

                    <!-- Cơ cấu giải -->
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Cơ cấu giải thưởng" Style="{StaticResource SectionTitleStyle}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Giải" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Số lượng" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Đã quay" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Giải Nhất" Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtPrize1Qty" Grid.Column="1" Width="86" HorizontalAlignment="Center" Style="{StaticResource ModernTextBoxStyle}" Text="1"/>
                                <Border Grid.Column="2" Width="86" Height="38" HorizontalAlignment="Center" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10">
                                    <TextBlock x:Name="txtPrize1Awarded" Text="0" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Giải Nhì" Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtPrize2Qty" Grid.Column="1" Width="86" HorizontalAlignment="Center" Style="{StaticResource ModernTextBoxStyle}" Text="2"/>
                                <Border Grid.Column="2" Width="86" Height="38" HorizontalAlignment="Center" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10">
                                    <TextBlock x:Name="txtPrize2Awarded" Text="0" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Giải Ba" Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtPrize3Qty" Grid.Column="1" Width="86" HorizontalAlignment="Center" Style="{StaticResource ModernTextBoxStyle}" Text="3"/>
                                <Border Grid.Column="2" Width="86" Height="38" HorizontalAlignment="Center" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10">
                                    <TextBlock x:Name="txtPrize3Awarded" Text="0" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Khuyến khích" Style="{StaticResource LabelStyle}" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtPrizeKKQty" Grid.Column="1" Width="86" HorizontalAlignment="Center" Style="{StaticResource ModernTextBoxStyle}" Text="5"/>
                                <Border Grid.Column="2" Width="86" Height="38" HorizontalAlignment="Center" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10">
                                    <TextBlock x:Name="txtPrizeKKAwarded" Text="0" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Button Content="Lưu cơ cấu giải"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="#F59E0B"
                                    Foreground="#111827"
                                    Margin="0"
                                    Click="BtnSavePrizeConfig_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Điều khiển quay -->
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Điều khiển quay thưởng" Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Chọn giải đang quay"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,0,0,6"/>

                            <ComboBox x:Name="cmbCurrentPrize"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      DisplayMemberPath="PrizeName"
                                      SelectedValuePath="PrizeName"
                                      SelectionChanged="CmbCurrentPrize_SelectionChanged"/>

                            <Border Background="#0F172A"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,12,0,12">
                                <TextBlock x:Name="txtPrizeStatus"
                                           Text="Chưa có dữ liệu giải thưởng"
                                           Foreground="#E2E8F0"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <CheckBox x:Name="chkRemoveWinner"
                                      Content="Loại người đã trúng khỏi vòng quay"
                                      Foreground="#E2E8F0"
                                      FontSize="14"
                                      IsChecked="True"
                                      Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Quay 1 lượt"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Background="#2563EB"
                                        Click="BtnSpin_Click"/>

                                <Button Grid.Column="2"
                                        Content="Quay hết giải đang chọn"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Background="#7C3AED"
                                        Margin="0"
                                        Click="BtnSpinCurrentPrize_Click"/>
                            </Grid>

                            <Button Content="Quay toàn bộ cơ cấu giải"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="#EC4899"
                                    Margin="0"
                                    Click="BtnSpinAll_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Lịch sử người trúng BÊN TRÁI -->
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Lịch sử người trúng"
                                           Foreground="#F8FAFC"
                                           FontWeight="Bold"
                                           FontSize="18"
                                           DockPanel.Dock="Left"/>
                                <TextBlock Text="Nền đen / chữ trắng"
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           DockPanel.Dock="Right"
                                           VerticalAlignment="Bottom"/>
                            </DockPanel>

                            <DataGrid x:Name="dgWinners"
                                      Grid.Row="1"
                                      Height="280"
                                      Style="{StaticResource ModernDataGridStyle}"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="65"/>
                                    <DataGridTextColumn Header="Người trúng" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Giải" Binding="{Binding PrizeName}" Width="130"/>
                                    <DataGridTextColumn Header="Thời gian" Binding="{Binding WinTime, StringFormat=dd/MM HH:mm:ss}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Kết quả gần nhất -->
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Kết quả gần nhất" Style="{StaticResource SectionTitleStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Người trúng" Foreground="#94A3B8" FontSize="12"/>
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,6,0,0">
                                        <TextBlock x:Name="txtLastWinner"
                                                   Text="Chưa có người trúng"
                                                   Foreground="#F8FAFC"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Giải" Foreground="#94A3B8" FontSize="12"/>
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,6,0,0">
                                        <TextBlock x:Name="txtLastPrize"
                                                   Text="-"
                                                   Foreground="#F59E0B"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Xuất / reset -->
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Dữ liệu và báo cáo" Style="{StaticResource SectionTitleStyle}"/>

                            <Button Content="Xuất danh sách trúng thưởng Excel"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="#10B981"
                                    Click="BtnExportWinners_Click"/>

                            <Button Content="Reset toàn bộ dữ liệu"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="#DC2626"
                                    Margin="0,4,0,0"
                                    Click="BtnResetAll_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- CỘT PHẢI: VÒNG QUAY -->
            <Border Grid.Column="2"
                    Background="#111827"
                    BorderBrush="#243046"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Vòng quay may mắn"
                                       Foreground="#F8FAFC"
                                       FontWeight="Bold"
                                       FontSize="22"/>
                            <TextBlock Text="Mũi tên cố định - vòng quay xoay bên dưới"
                                       Foreground="#94A3B8"
                                       FontSize="13"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="860"
                                Height="860"
                                CornerRadius="28"
                                Background="#0F172A"
                                BorderBrush="#223047"
                                BorderThickness="1.2"/>

                        <!-- MŨI TÊN -->
                        <Grid Width="860"
                              Height="860"
                              IsHitTestVisible="False"
                              Panel.ZIndex="100">
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  Margin="0,56,0,0">
                                <!-- thân -->
                                <Border Width="8"
                                        Height="30"
                                        Background="#F59E0B"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,0,0,0"/>
                                <!-- đầu nhọn chỉ VÀO TRONG -->
                                <Path Fill="#F59E0B"
                                      Stroke="White"
                                      StrokeThickness="1.2"
                                      Data="M 0 0 L 20 0 L 10 26 Z"
                                      Width="20"
                                      Height="26"
                                      Stretch="Fill"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Top"
                                      Margin="0,24,0,0"/>
                            </Grid>
                        </Grid>

                        <!-- KHU VÒNG QUAY -->
                        <Grid Width="780"
                              Height="780"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Canvas x:Name="LightCanvas"
                                    Width="760"
                                    Height="760"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="1"/>

                            <Canvas x:Name="WheelCanvas"
                                    Width="760"
                                    Height="760"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5"
                                    Panel.ZIndex="2">
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="wheelRotate" Angle="0"/>
                                </Canvas.RenderTransform>
                            </Canvas>

                            <!-- NÚT QUAY -->
                            <Button x:Name="btnSpinCenter"
                                    Width="140"
                                    Height="140"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="BtnSpin_Click"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="White"
                                    Panel.ZIndex="10">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse x:Name="SpinEllipse"
                                                     Fill="#F59E0B"
                                                     Stroke="White"
                                                     StrokeThickness="4"/>
                                            <Ellipse Width="108"
                                                     Height="108"
                                                     Fill="#F97316"
                                                     Opacity="0.28"/>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="QUAY"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="Bold"
                                                           FontSize="28"
                                                           Foreground="White"/>
                                                <TextBlock Text="SPIN"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="#FFF7ED"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SpinEllipse" Property="Opacity" Value="0.92"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="SpinEllipse" Property="Opacity" Value="0.84"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="SpinEllipse" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>