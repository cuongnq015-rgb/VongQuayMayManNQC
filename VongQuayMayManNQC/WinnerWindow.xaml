<Window x:Class="VongQuayMayManNQC.WinnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="760" Height="430"
        Topmost="True"
        ShowInTaskbar="False">
    <Grid>
        <Border CornerRadius="28"
                Background="#111827"
                BorderBrush="#FBBF24"
                BorderThickness="3"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#F59E0B"
                        CornerRadius="20"
                        Padding="18"
                        Margin="0,0,0,18">
                    <TextBlock x:Name="txtTitle"
                               Text="🎉 CHÚC MỪNG 🎉"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="NGƯỜI TRÚNG THƯỞNG"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#E5E7EB"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <Border Background="#1F2937" CornerRadius="22" Padding="20" Margin="30,0">
                        <StackPanel>
                            <TextBlock x:Name="txtWinner"
                                       Text="Nguyễn Văn A"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="#FDE68A"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>

                            <TextBlock x:Name="txtPrize"
                                       Text="GIẢI NHẤT"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#93C5FD"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Row="2"
                        Content="ĐÓNG"
                        Width="140" Height="42"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        Click="Close_Click"
                        Background="#EF4444"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>